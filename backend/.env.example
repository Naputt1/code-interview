# Copy to .env and adjust. Defaults target the Docker Postgres in
# infra/docker-compose.yml, i.e. the same values as the built-in defaults.
SERVER_ADDR=:8080
DATABASE_URL=postgres://tracker:tracker@127.0.0.1:5432/tracker?sslmode=disable
# Using a local Postgres instead of Docker, for example:
# DATABASE_URL=postgres://naputt@127.0.0.1:5432/code_interview?sslmode=disable
LOG_LEVEL=info
# Seed a demo manufacturing line the first time the database is empty.
SEED_IF_EMPTY=true
