                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/service.Board"
                        }
                    }
                }
            }
        },
        "/consumptions": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "views"
                ],
                "summary": "Recent entries from the consumption ledger",
