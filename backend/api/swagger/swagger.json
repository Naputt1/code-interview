{
    "consumes": [
        "application/json"
    ],
    "produces": [
        "application/json"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Track orders through a configurable multi-step manufacturing process and monitor resource consumption.",
        "title": "Manufacturing Process Tracker API",
        "contact": {},
        "version": "1.0.0"
    },
    "basePath": "/api",
